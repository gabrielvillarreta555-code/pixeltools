  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "5.3.0"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "markdown-it": "15.0.3",
    "playwright": "1.63.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
