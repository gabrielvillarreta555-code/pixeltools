# Dominio público definitivo, sin barra al final. SITE_URL y VITE_SITE_URL son
# equivalentes. Déjalos vacíos en despliegues de prueba: entonces el sitio usa la
# URL que asigna Cloudflare Pages y todas las páginas llevan noindex.
# Configúralo solo cuando el sitio deba aparecer en buscadores.
SITE_URL=

# Dirección que abrirá el formulario de contacto mediante mailto:.
VITE_CONTACT_EMAIL=contacto@tu-dominio.example
